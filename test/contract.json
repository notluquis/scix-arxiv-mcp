    {
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Get full metadata and abstract for a specific arXiv paper by its ID (e.g. \"2103.01231\"). Returns title, authors, abstract, categories, and links to PDF and HTML versions.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
