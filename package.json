{
  "name": "scix-arxiv-mcp",
  "version": "2.0.2",
  "description": "Local stdio MCP server for SciX (NASA ADS) and arXiv (MCP 2026-07-28)",
  "license": "MIT",
  "author": "Lucas Pulgar Escobar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notluquis/scix-arxiv-mcp.git"
  },
  "bin": {
    "scix-arxiv-mcp": "build/index.js"
  },
  "files": [
    "build",
    "data/scix",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "pdf-parse": "2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
